# ── LOCAL TIER (pick this) ────────────────────────────────────────────────
DELAPAN_BACKEND=local
OPENAI_API_KEY=sk-...            # required — embeddings (text-embedding-3-small)
# ANTHROPIC_API_KEY=sk-ant-...   # optional — LLM features (synopsis, extraction)
# TAVILY_API_KEY=tvly-...        # optional — web search for explore
# DELAPAN_DB_PATH=~/.delapan/delapan.db

# ── CLOUD TIER (optional, self-hosted multi-tenant; needs pip install ".[cloud]") ──
# DELAPAN_BACKEND=cloud
# SUPABASE_URL=https://...
# SUPABASE_ANON_KEY=...
# SUPABASE_SERVICE_ROLE_KEY=...
# SUPABASE_JWT_SECRET=...
# DATABASE_URL=postgresql://...
# AI_GATEWAY_API_KEY=...
